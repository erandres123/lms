{
  "name": "@lms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prestart:dev": "pnpm --filter @lms/shared build",
    "test": "vitest run",
    "pretest": "pnpm --filter @lms/shared build",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "pretest:e2e": "pnpm --filter @lms/shared build",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "pretest:integration": "pnpm --filter @lms/shared build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/local-db.ts",
    "provision:tenant": "tsx src/scripts/provision-tenant.ts",
    "dev:token": "tsx src/scripts/dev-token.ts",
    "demo:seed": "tsx src/scripts/seed-demo.ts",
    "backup:drill": "node --env-file=.env scripts/backup-drill.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lms/shared": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "livekit-server-sdk": "^2.19.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.11.0-beta.19",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
