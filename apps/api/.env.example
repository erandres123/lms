NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://lms:lms@localhost:5432/lms
# For Supabase (or any managed Postgres with a private CA), point this at the
# downloaded root certificate to enable verified TLS.
# DATABASE_SSL_CA=certs/supabase-root-2021-ca.crt
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=log
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# FCM service-account JSON, relative to apps/api. Blank keeps push delivery disabled.
# FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-service-account.json
